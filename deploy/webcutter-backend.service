[Unit]
Description=Webcutter backend (NestJS / GRBL laser cutter controller)
After=network.target

[Service]
Type=simple
User=webcutter
WorkingDirectory=/opt/webcutter/backend
ExecStart=/usr/bin/node main.js
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=DATABASE_PATH=/opt/webcutter/data/webcutter.db
# Real production box: unlike a Claude Code test run, this is expected to set
# ALLOW_PHYSICAL_CONNECTION itself (see CLAUDE.md "ALLOW_PHYSICAL_CONNECTION safeguard").
Environment=ALLOW_PHYSICAL_CONNECTION=true

# USB serial access (dialout normally owns /dev/ttyUSB0 on Debian/Ubuntu-based images)
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
