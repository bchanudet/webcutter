// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
	"name": "Node.js & TypeScript",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/typescript-node:4-24-trixie",
	"features": {
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers-extra/features/nestjs-cli:2": {},
		"ghcr.io/devcontainers-extra/features/angular-cli:2": {},
		"ghcr.io/devcontainers-extra/features/nx-npm:1": {},
		"ghcr.io/devcontainers-extra/features/prek:1": {}
	},
	"privileged": true,
	"runArgs": ["--device=/dev/ttyUSB0", "--network=host"],
	
	
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [4200],
	
	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": {
		"claude:folder": "sudo chown node /home/node/.claude",
		"dep": "sudo chown node node_modules && npm ci"//,
		//"install:prek": "prek install --prepare-hooks"
	}, 
	
	"mounts": [
		"source=claude-code-config,target=/home/node/.claude,type=volume",
		"source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
	],
	
	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"Angular.ng-template",
				"nrwl.angular-console",
				"anthropic.claude-code"
			],
			"settings": {
				"telemetry.feedback.enabled": false // Disable VSCode Telemetry
			}
		}
	}
}
